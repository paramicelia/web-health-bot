# At least one of these must be set for the vision layer.
# Groq is preferred (fast + free tier). Anthropic is the optional fallback.
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Models — defaults are fine.
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Runtime
HEADLESS=true
NAVIGATION_TIMEOUT_MS=15000
SLOW_THRESHOLD_MS=8000
VERY_SLOW_THRESHOLD_MS=15000
MIN_TEXT_LENGTH=120

ARTIFACTS_DIR=./artifacts
LOG_LEVEL=INFO
